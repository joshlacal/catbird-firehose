# Exact commits of the sibling checkouts Cargo.toml reaches through `path = "../..."`.
# scripts/check-canonical-sibling-provenance.sh refuses to pass unless each sibling is
# checked out at exactly this commit with no local changes. CI clones these SHAs.
#
# Change these only together with a build and test run against the new commits.
PETREL_SIBLING_DIR=../Petrel
PETREL_COMMIT=cd6dda0d25c1d2ab2365eb8f6ba2f4568960dd07
PETREL_CATBIRD_SIBLING_DIR=../PetrelCatbird
PETREL_CATBIRD_COMMIT=7658265cdc4eebd6cbb37b30fc1f385892168b19
